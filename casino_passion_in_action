# Sfida Secca dei Dadi
# __________________________________________
FACCE_DADO = {1:'⚀', 2:'⚁', 3:'⚂', 4:'⚃', 5:'⚄', 6:'⚅'}

def lancia_dado():
    return random.randint(1, 6)

def animazione_dado():
    for _ in range(3):
        print("🎲 ...", end='\r')
        time.sleep(0.3)
        print("🎲    ", end='\r')
        time.sleep(0.2)

def gioca_sfida_dadi(fiches, storia):
    clear_output(wait=True)
    print("=" * 40)
    print("      🎲  SFIDA SECCA DEI DADI  🎲")
    print("=" * 40)
    print("Regole: tu e il bancone lanciate un dado.")
    print("Chi fa il numero più alto vince la puntata.")
    print("In caso di parità si rilancia finché qualcuno vince.")
    print("-" * 40)
    fai_puntata(fiches)
    round_n = 1
    while True:
        if round_n > 1:
            print(f"\n[Rilancio #{round_n} - pareggio precedente]")
        else:
            print()
        input("Premi Invio per lanciare il dado...")
        animazione_dado()
        dado_gioc = lancia_dado()
        dado_banco = lancia_dado()
        print(f"\nTuo dado:    {FACCE_DADO[dado_gioc]}  ({dado_gioc})")
        print(f"Dado Banco:  {FACCE_DADO[dado_banco]}  ({dado_banco})")
        time.sleep(0.5)
        if dado_gioc > dado_banco:
            print(f"\n🏆 HAI VINTO! {dado_gioc} batte {dado_banco}!")
            fiches.vince_puntata()
            break
        elif dado_banco > dado_gioc:
            print(f"\n💀 IL BANCO VINCE! {dado_banco} batte {dado_gioc}. Meglio la prossima volta.")
            fiches.perde_puntata()
            break
        else:
            print(f"\n🤝 PAREGGIO! ({dado_gioc} = {dado_banco}) Si rilancia...")
            time.sleep(1)
            round_n += 1
    storia.append(fiches.totale)
    time.sleep(4)

