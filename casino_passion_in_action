# Blackjack
# __________________________________________
SEMI_BJ = ('Cuori', 'Quadri', 'Picche', 'Fiori')
RANGHI_BJ = ('Due', 'Tre', 'Quattro', 'Cinque', 'Sei', 'Sette', 'Otto', 'Nove', 'Dieci', 'Jack', 'Regina', 'Re', 'Asso')
VALORI_BJ = {'Due':2, 'Tre':3, 'Quattro':4, 'Cinque':5, 'Sei':6, 'Sette':7, 'Otto':8, 'Nove':9, 'Dieci':10, 'Jack':10, 'Regina':10, 'Re':10, 'Asso':11}

class Mazzo:
    def __init__(self):
        self.mazzo = [Carta(s, r) for s in SEMI_BJ for r in RANGHI_BJ]
    def mescola(self):
        random.shuffle(self.mazzo)
    def distribuisci(self):
        return self.mazzo.pop()

class Mano:
    def __init__(self):
        self.carte = []
        self.valore = 0
        self.assi = 0
    def aggiungi_carta(self, carta):
        self.carte.append(carta)
        self.valore += VALORI_BJ[carta.rango]
        if carta.rango == 'Asso': self.assi += 1
    def regola_per_asso(self):
        while self.valore > 21 and self.assi:
            self.valore -= 10
            self.assi -= 1

def gioca_blackjack(fiches, storia):
    clear_output(wait=True)
    print("-- EL TAVOLO DEL BLACKJACK :) --")
    mazzo = Mazzo()
    mazzo.mescola()

    mano_gioc = Mano()
    mano_banco = Mano()
    for _ in range(2):
        mano_gioc.aggiungi_carta(mazzo.distribuisci())
        mano_banco.aggiungi_carta(mazzo.distribuisci())

    mano_gioc.regola_per_asso()
    mano_banco.regola_per_asso()

    fai_puntata(fiches)

    # Turno Giocatore
    while True:
        print(f"\nCarte Banco: <coperta> e {mano_banco.carte[1]}")
        print("Tue carte, coprile:")
        for c in mano_gioc.carte: print(f" - {c}")
        print(f"Valore: {mano_gioc.valore}")

        if mano_gioc.valore > 21:
            print("HAI SBALLATO, GODO!")
            fiches.perde_puntata()
            storia.append(fiches.totale)
            time.sleep(3)
            return

        scelta = input("Vuoi carta (h) o c'hai paura? Stai con (s)? ").lower()
        if scelta == 'h':
            mano_gioc.aggiungi_carta(mazzo.distribuisci())
            mano_gioc.regola_per_asso()
        elif scelta == 's':
            break

    # Turno Banco
    print("\nTurno del Banco...")
    while mano_banco.valore < 17:
        mano_banco.aggiungi_carta(mazzo.distribuisci())
        mano_banco.regola_per_asso()

    print("\nCarte Banco definitive:")
    for c in mano_banco.carte: print(f" - {c}")
    print(f"Valore Banco: {mano_banco.valore}")

    if mano_banco.valore > 21:
        print("IL BANCO SBALLA! HAI AVUTO FORTUNA!!!!! (Per una volta)")
        fiches.vince_puntata()
    elif mano_banco.valore >= mano_gioc.valore:
        print("IL BANCO VINCE! AH")
        fiches.perde_puntata()
    elif mano_banco.valore < mano_gioc.valore:
        print("VINCI!")
        fiches.vince_puntata()

    storia.append(fiches.totale)
    time.sleep(7)

