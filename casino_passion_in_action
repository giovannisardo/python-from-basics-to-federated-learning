# __________________________________________
# Classi e funzioni condivise
# __________________________________________
class Carta:
    def __init__(self, seme, rango):
        self.seme = seme
        self.rango = rango
    def __str__(self):
        return f"{self.rango} di {self.seme}"

class Fiches:
    def __init__(self, totale=100):
        self.totale = totale
        self.puntata = 0
    def vince_puntata(self):
        self.totale += self.puntata
    def perde_puntata(self):
        self.totale -= self.puntata

def fai_puntata(fiches):
    while True:
        try:
            fiches.puntata = int(input(f"Hai {fiches.totale} fiches. Quanto vuoi puntare? "))
        except ValueError:
            print("Inserisci un numero intero!")
        else:
            if fiches.puntata > fiches.totale:
                print(f"Non hai abbastanza fiches! Ne hai: {fiches.totale}")
            elif fiches.puntata <= 0:
                print("Devi puntare qualcosa!")
            else:
                break

