# Poker Messicano (Mentiroso)
# __________________________________________
FACCE_DADO_MINI = {1:'①', 2:'②', 3:'③', 4:'④', 5:'⑤', 6:'⑥'}

def conta_dadi(dadi, valore_min):
    return sum(1 for d in dadi if d >= valore_min)

def dichiarazione_banco(dadi_banco, ultima_dichiarazione):
    prev_q, prev_v = ultima_dichiarazione if ultima_dichiarazione else (0, 1)
    dichiarazioni_valide = [
        (q, v) for v in range(1, 7) for q in range(1, 6)
        if (q > prev_q) or (q == prev_q and v > prev_v)
    ]
    if not dichiarazioni_valide:
        return (5, 6)
    dichiarazioni_oneste = [
        (q, v) for (q, v) in dichiarazioni_valide
        if conta_dadi(dadi_banco, v) >= q
    ]
    if random.random() < 0.40 or not dichiarazioni_oneste:
        return random.choice(dichiarazioni_valide)
    else:
        dichiarazioni_oneste.sort(key=lambda x: (x[0], x[1]))
        idx = random.randint(0, max(0, len(dichiarazioni_oneste) // 2))
        return dichiarazioni_oneste[idx]

def stampa_dadi(dadi, nascosti=False):
    if nascosti:
        return "[ " + " | ".join("🎲" for _ in dadi) + " ]"
    return "[ " + " | ".join(f"{FACCE_DADO_MINI[d]}({d})" for d in dadi) + " ]"

def gioca_poker_messicano(fiches, storia):
    clear_output(wait=True)
    print("=" * 40)
    print("  🇲🇽  POKER MESSICANO (Mentiroso)  🇲🇽")
    print("=" * 40)
    print("Regole: entrambi lanciano 5 dadi segreti.")
    print("Il banco dichiara quanti dadi ha con valore ≥ X.")
    print("[C]redi → devi dichiarare qualcosa di più alto.")
    print("[B]ugiardo → si scoprono i dadi del banco.")
    print("3 vite ciascuno. Chi le perde tutte, perde!")
    print("-" * 40)
    input("Premi Invio per iniziare...")
    fai_puntata(fiches)

    vite_gioc = vite_banco = 3

    while vite_gioc > 0 and vite_banco > 0:
        clear_output(wait=True)
        print(f"❤️  Tue vite: {vite_gioc}  |  🏦 Vite banco: {vite_banco}")
        print("-" * 40)

        dadi_gioc  = [lancia_dado() for _ in range(5)]
        dadi_banco = [lancia_dado() for _ in range(5)]
        print(f"I tuoi dadi: {stampa_dadi(dadi_gioc)}")

        dichiarazione = None
        turno = "banco"

        while True:
            # ── Turno banco ──────────────────────────────
            if turno == "banco":
                q, v = dichiarazione_banco(dadi_banco, dichiarazione)
                dichiarazione = (q, v)
                print(f"\n🏦 Banco dichiara: almeno {q} dado/i ≥ {v}")

                scelta = ""
                while scelta not in ("C", "B"):
                    scelta = input("[C]redi / [B]ugiardo? ").strip().upper()

                if scelta == "B":
                    print(f"\n🔍 Dadi banco: {stampa_dadi(dadi_banco)}")
                    reali = conta_dadi(dadi_banco, v)
                    if reali >= q:
                        print("❌ Era onesto! Perdi una vita.")
                        vite_gioc -= 1
                    else:
                        print("✅ Bluffava! Banco perde una vita.")
                        vite_banco -= 1
                    time.sleep(2)
                    break

                turno = "giocatore"

            # ── Turno giocatore ───────────────────────────
            else:
                prev_q, prev_v = dichiarazione
                print(f"\nI tuoi dadi: {stampa_dadi(dadi_gioc)}")
                print(f"Devi dichiarare più di ({prev_q} dadi ≥ {prev_v})")

                while True:
                    try:
                        q = int(input("  Quanti dadi? (1-5): "))
                        v = int(input("  Valore minimo? (1-6): "))
                        if 1 <= q <= 5 and 1 <= v <= 6 and (q > prev_q or (q == prev_q and v > prev_v)):
                            break
                        print("  ⚠️  Dichiarazione non valida o non più alta!")
                    except ValueError:
                        print("  Inserisci un numero!")

                dichiarazione = (q, v)
                print(f"\n👤 Dichiari: almeno {q} dado/i ≥ {v}")

                attesi = 10 * (7 - v) / 6
                if q > attesi * 1.5 or random.random() < 0.25:
                    print("🏦 Banco chiama BUGIARDO!")
                    print(f"   Tuoi dadi: {stampa_dadi(dadi_gioc)}")
                    if conta_dadi(dadi_gioc, v) >= q:
                        print("✅ Eri onesto! Banco perde una vita.")
                        vite_banco -= 1
                    else:
                        print("❌ Bluffavi! Perdi una vita.")
                        vite_gioc -= 1
                    time.sleep(2)
                    break
                else:
                    print("🏦 Banco crede.")
                    turno = "banco"

        input("\nPremi Invio per il prossimo round...")

    # ── Risultato finale ──────────────────────────────────
    clear_output(wait=True)
    print(f"\nVite finali → Tu: {vite_gioc} | Banco: {vite_banco}")
    if vite_gioc > vite_banco:
        print("🏆 HAI VINTO IL POKER MESSICANO!")
        fiches.vince_puntata()
    elif vite_banco > vite_gioc:
        print("💀 IL BANCO VINCE!")
        fiches.perde_puntata()
    else:
        print("🤝 PAREGGIO!")

    storia.append(fiches.totale)
    time.sleep(4)

