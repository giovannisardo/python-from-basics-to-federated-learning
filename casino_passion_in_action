class MazzoSetteMezzo:
    def __init__(self):
        self.mazzo = [Carta(s, r) for s in SEMI_ITA for r in RANGHI_ITA]
    def mescola(self):
        random.shuffle(self.mazzo)
    def distribuisci(self):
        return self.mazzo.pop()

class ManoSetteMezzo:
    def __init__(self):
        self.carte = []
        self.valore = 0.0
    def aggiungi_carta(self, carta):
        self.carte.append(carta)
        self.valore += VALORI_ITA[carta.rango]

def gioca_sette_mezzo(fiches, storia):
    clear_output(wait=True)
    print("-- TAVOLO DI SETTE E MEZZO--")
    mazzo = MazzoSetteMezzo()
    mazzo.mescola()

    mano_gioc = ManoSetteMezzo()
    mano_banco = ManoSetteMezzo()
