    mano_gioc.aggiungi_carta(mazzo.distribuisci())
    mano_banco.aggiungi_carta(mazzo.distribuisci())

    while True:
        print("\nLe tue carte:")
        for c in mano_gioc.carte: print(f" - {c}")
        print(f"Valore totale: {mano_gioc.valore}")

        if mano_gioc.valore > 7.5:
            print("HAI SBALLATO!")
