def analizza_partita(storia):
    clear_output(wait=True)
    if len(storia) <= 1:
        print("Devi giocare almeno una mano prima di vedere il grafico!")
        return
    y = np.array(storia)
    x = np.arange(len(y))
    plt.style.use('ggplot')
    fig, ax = plt.subplots(figsize=(10, 5))
    ax.plot(x, y, marker='o', color='royalblue', linestyle='-', linewidth=2, label="Bankroll")
    ax.axhline(y=storia[0], color='red', linestyle='--', label=f"Capitale iniziale ({storia[0]} fiches)")
    ax.fill_between(x, storia[0], y, where=(y >= storia[0]), alpha=0.15, color='green', label='Profitto')
    ax.fill_between(x, storia[0], y, where=(y < storia[0]),  alpha=0.15, color='red',   label='Perdita')
    ax.set_title('📈 Andamento Fiches nel Casinò', fontsize=14, fontweight='bold')
    ax.set_xlabel('Numero di Azioni / Mani Giocate')
    ax.set_ylabel('Totale Fiches')
    ax.set_xticks(x)
    ax.legend()
    ax.grid(True)
    fig.tight_layout()
    fig.savefig('andamento_fiches.png', dpi=120)
    display(fig)
    plt.close(fig)
    print(f"\n📊 Statistiche — Picco massimo: {np.max(y):.1f} | Minimo: {np.min(y):.1f} | Attuale: {y[-1]:.1f} fiches")
    print("💾 Grafico salvato come 'andamento_fiches.png'")

